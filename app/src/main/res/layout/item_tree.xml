<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/white">

        <androidx.cardview.widget.CardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/iv_tree_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="@string/app_name"
                android:background="@color/sandal_light" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tree_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tree ID"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/wood_brown" />

            <TextView
                android:id="@+id/tv_tree_girth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Girth: 25cm"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/tv_maturity_estimate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maturity: 30%"
                android:textColor="@color/leaf_green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <ProgressBar
                android:id="@+id/pb_maturity"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="30"
                android:progressDrawable="@drawable/custom_progress_drawable" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
