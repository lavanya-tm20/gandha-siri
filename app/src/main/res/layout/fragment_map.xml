<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sandal_bg">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_map"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map_container"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".MapFragment" />

        <TextView
            android:id="@+id/tv_map_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/guard_active"
            android:textSize="12sp"
            android:visibility="gone"
            android:padding="20dp"
            android:textAlignment="center" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/ll_proximity_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toBottomOf="@id/cv_map">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asset Proximity Audit"
                android:textStyle="bold"
                android:textColor="@color/wood_brown"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_user_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Syncing farm coordinates..."
                android:textColor="@color/leaf_green"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_radar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_location"
            android:background="@drawable/circular_bg"
            android:padding="10dp"
            app:tint="@color/leaf_green"
            android:contentDescription="Location Sync" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_nearby_trees"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_proximity_stats"
        tools:listitem="@layout/item_tree" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_refresh_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:srcCompat="@drawable/ic_location"
        app:backgroundTint="@color/wood_brown"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/gold"
        android:contentDescription="Refresh Audit" />

</androidx.constraintlayout.widget.ConstraintLayout>
