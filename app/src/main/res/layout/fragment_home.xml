<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sandal_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Farmer Welcome Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/namaste_farmer"
                        android:textColor="@color/wood_brown"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/guard_active"
                        android:textColor="@color/leaf_green"
                        android:textSize="13sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Natural Wealth Summary Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_wealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="10dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/wealth_card_gradient"
                    android:padding="24dp">
                    <TextView
                        android:id="@+id/tv_label_wealth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wealth_valuation_label"
                        android:textColor="#E0E0E0"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textAllCaps="true" />
                    <TextView
                        android:id="@+id/tv_total_valuation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tv_label_wealth"
                        android:layout_marginTop="4dp"
                        android:text="₹ 0.00"
                        android:textColor="@color/white"
                        android:textSize="36sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_tree_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tv_total_valuation"
                        android:layout_marginTop="4dp"
                        android:text="0 trees tagged"
                        android:textColor="#BDBDBD"
                        android:textSize="14sp" />
                    <View
                        android:id="@+id/divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_below="@id/tv_tree_count"
                        android:layout_marginTop="16dp"
                        android:background="#4DFFFFFF" />
                    <TextView
                        android:id="@+id/tv_harvest_estimate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/divider"
                        android:layout_marginTop="12dp"
                        android:text="Next Harvest: --"
                        android:textColor="@color/gold"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. LITE MODE ENGINE: Estate Preview Map -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/farm_estate_preview"
                android:textColor="@color/wood_brown"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- FIXED: Standardized ID to home_map_container -->
                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/home_map_container"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        map:liteMode="true"
                        map:mapType="satellite" />

                    <Button
                        android:id="@+id/btn_view_full_map"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/view_full_map"
                        android:textColor="@color/leaf_green"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Operational Center Quick Links -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/operation_center"
                android:textColor="@color/wood_brown"
                android:textSize="18sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_register"
                        android:layout_width="140dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="@color/sandal_light"
                        app:cardCornerRadius="20dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/tag_new_tree" android:textStyle="bold" android:textColor="@color/wood_brown" android:textAlignment="center" android:padding="8dp"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_panic"
                        android:layout_width="140dp"
                        android:layout_height="100dp"
                        app:cardBackgroundColor="#FBE9E7"
                        app:cardCornerRadius="20dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/panic_label" android:textStyle="bold" android:textColor="#C62828" android:textAlignment="center" android:padding="8dp"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </HorizontalScrollView>

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart_wealth_growth"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:padding="16dp"
                android:layout_marginBottom="60dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
