<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sandal_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_detail_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/wood_brown"
                android:text="Tree ID: SAN-XXXX" />

            <ImageButton
                android:id="@+id/btn_delete_tree"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#B00020"
                android:contentDescription="Delete Tree" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/iv_detail_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/sandal_medium"
                    android:contentDescription="@string/app_name" />

                <View
                    android:id="@+id/v_scanning_bar"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="#00FF00"
                    android:visibility="gone"
                    android:elevation="4dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- GenAI Advisor Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFF9C4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ GenAI Tree Advisor"
                    android:textStyle="bold"
                    android:textColor="@color/wood_brown"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_ai_advice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap below for AI-powered health analysis."
                    android:textColor="#5D4037"
                    android:lineSpacingExtra="4dp" />

                <Button
                    android:id="@+id/btn_ask_ai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Run AI Vision Scan"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    app:icon="@drawable/ic_view" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Growth Tracker Graph -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Growth Tracker (Girth over Time)"
                    android:textStyle="bold"
                    android:textColor="@color/wood_brown" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_growth_history"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Maturity Gauge Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heartwood Maturity Estimation"
                    android:textStyle="bold"
                    android:textColor="@color/wood_brown" />

                <FrameLayout
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp">

                    <ProgressBar
                        android:id="@+id/pb_maturity_gauge"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        android:progress="30"
                        android:progressDrawable="@drawable/circular_progress_bar" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_maturity_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30%"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:textColor="@color/wood_brown" />

                        <TextView
                            android:id="@+id/tv_maturity_status_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GROWING"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/leaf_green" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_harvest_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/harvest_countdown_format"
                    android:textColor="@color/wood_brown"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_heartwood_estimate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/heartwood_estimate_format"
                    android:textColor="@color/leaf_green"
                    android:textSize="12sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_view_map"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Locate on Farm Map"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:icon="@drawable/ic_map" />

        <Button
            android:id="@+id/btn_add_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Add New Girth Entry"
            app:icon="@drawable/ic_add" />

        <Button
            android:id="@+id/btn_generate_cert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_official_certificate"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:backgroundTint="@color/wood_brown"
            app:icon="@android:drawable/ic_menu_agenda" />

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
